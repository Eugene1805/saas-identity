# Variables de entorno de ejemplo para desarrollo local en Docker Compose (sin secretos reales)
POSTGRES_DB=vital_identity
POSTGRES_USER=vital_identity
POSTGRES_PASSWORD=vital_identity_dev_pass

# Clave HS256 de al menos 32 caracteres solo para desarrollo local
JWT_SIGNING_KEY=VitalIdentityDevSigningKeyChangeInProd2026!
SEED_DEMO_DATA=true
OPENAPI_ENABLED=true
