# Plantilla de variables para Docker Compose multitenant (copiar a `.env` local; nunca versionar `.env`)

POSTGRES_GLOBAL_DB=vital_identity_global
POSTGRES_GLOBAL_USER=vital_identity_global
POSTGRES_GLOBAL_PASSWORD=CHANGE_ME_LOCAL_GLOBAL_PG_PASS

POSTGRES_NORTE_DB=vital_identity_norte
POSTGRES_NORTE_USER=vital_identity_norte
POSTGRES_NORTE_PASSWORD=CHANGE_ME_LOCAL_NORTE_PG_PASS

POSTGRES_VALLE_DB=vital_identity_valle
POSTGRES_VALLE_USER=vital_identity_valle
POSTGRES_VALLE_PASSWORD=CHANGE_ME_LOCAL_VALLE_PG_PASS

POSTGRES_AURORA_DB=vital_identity_aurora
POSTGRES_AURORA_USER=vital_identity_aurora
POSTGRES_AURORA_PASSWORD=CHANGE_ME_LOCAL_AURORA_PG_PASS

# Claves RSA RS256 (>= 2048 bits, formato PEM con saltos \n en una linea), secreto HMAC exclusivo para refresh tokens (>= 32 bytes) y credencial gRPC interna (>= 16 bytes).
# Generacion local sugerida (PowerShell / Bash):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   openssl rand -hex 32   # para JWT_REFRESH_TOKEN_HMAC_KEY
JWT_PRIVATE_KEY_PEM=CHANGE_ME_LOCAL_RSA_PRIVATE_KEY_PEM_WITH_ESCAPED_NEWLINES
JWT_PUBLIC_KEY_PEM=
JWT_REFRESH_TOKEN_HMAC_KEY=CHANGE_ME_LOCAL_REFRESH_HMAC_KEY_AT_LEAST_32_BYTES
INTERNAL_GRPC_API_KEY=CHANGE_ME_LOCAL_INTERNAL_GRPC_KEY
PLATFORM_MODE=Local
PLATFORM_GRPC_ADDRESS=http://platform-api:8092
EMAIL_MODE=LogOnly
EMAIL_FROM_ADDRESS=no-reply@vital.demo

# Opcional para entornos de prueba locales: activa semillas sinteticas solo con clave explicita
SEED_DEMO_DATA=false
DEMO_SEED_PASSWORD=CHANGE_ME_ONLY_FOR_LOCAL_DEMO_TEST
OPENAPI_ENABLED=true
