    {
      "name": "08. CU-13: Login válido Dra. Mendoza en clinica-norte",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login válido emite JWT Bearer, Refresh Token y fechas GMT-6', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.tokenType).to.eql('Bearer');",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
              "  pm.expect(body.accessTokenExpiresAtGmt6).to.include('-06:00');",
              "  pm.expect(body.account.role).to.eql('ESPECIALISTA');",
              "  pm.expect(body.tenant.slug).to.eql('clinica-norte');",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "  pm.collectionVariables.set('refreshToken1', body.refreshToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clinicSlug\": \"clinica-norte\",\n  \"email\": \"dra.mendoza@norte.vital.demo\",\n  \"password\": \"Vital2026!\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/login"
      }
    },
    {
      "name": "09. GET /v1/auth/me con JWT devuelve perfil completo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Perfil autenticado incluye atribución y permisos', () => {",
              "  pm.response.to.have.status(200);",
              "  const profile = pm.response.json();",
              "  pm.expect(profile.email).to.eql('dra.mendoza@norte.vital.demo');",
              "  pm.expect(profile.permissions.canPrescribe).to.eql(true);",
              "  pm.expect(profile.professionalAttribution.licenseCode).to.eql('CED-FICT-4012');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/auth/me"
      }
    },
    {
      "name": "10. POST /v1/auth/refresh rota token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refresh entrega un nuevo par de tokens', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.refreshToken).to.be.a('string').and.not.eql(pm.collectionVariables.get('refreshToken1'));",
              "  pm.collectionVariables.set('refreshToken2', body.refreshToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken1}}\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/refresh"
      }
    },
    {
      "name": "11. Reutilizar refreshToken1 detecta reuso y revoca cadena",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Reutilización de token rotado devuelve 401 REFRESH_TOKEN_REVOKED', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().code).to.eql('REFRESH_TOKEN_REVOKED');",
              "});"
