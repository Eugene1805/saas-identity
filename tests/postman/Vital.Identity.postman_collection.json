{
  "info": {
    "name": "Vital - saas-identity (Incremento 1)",
    "description": "Pruebas automatizadas de autenticación multitenant CU-13, JWT Bearer, rotación y revocación de Refresh Tokens en PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Health check y PostgreSQL",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health retorna 200 Healthy con DB conectada', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('Healthy');",
              "  pm.expect(body.database).to.eql('Connected');",
              "  pm.expect(body.timestampGmt6).to.include('-06:00');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "01b. Liveness probe (/health/live)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Liveness retorna 200 Healthy sin depender de DB', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('Healthy');",
              "  pm.expect(body.service).to.eql('saas-identity');",
              "  pm.expect(body.probe).to.eql('live');",
              "  pm.expect(body.scope).to.eql('process-only');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/live"
      }
    },
    {
      "name": "01c. Readiness probe (/health/ready)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Readiness retorna 200 Healthy con PostgreSQL Connected', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('Healthy');",
              "  pm.expect(body.service).to.eql('saas-identity');",
              "  pm.expect(body.probe).to.eql('ready');",
              "  pm.expect(body.database).to.eql('Connected');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/ready"
      }
    },
    {
      "name": "02. Documento OpenAPI v1 disponible",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('OpenAPI v1 JSON válido y documenta rutas auth', () => {",
              "  pm.response.to.have.status(200);",
              "  const spec = pm.response.json();",
              "  pm.expect(spec.paths).to.have.property('/v1/auth/login');",
              "  pm.expect(spec.paths).to.have.property('/v1/auth/platform/login');",
              "  pm.expect(spec.paths).to.have.property('/v1/auth/refresh');",
              "  pm.expect(spec.paths).to.have.property('/v1/auth/logout');",
              "  pm.expect(spec.paths).to.have.property('/v1/auth/me');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/openapi/v1.json"
      }
    },
