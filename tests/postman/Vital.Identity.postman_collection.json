    {
      "name": "16. GET /v1/staff lista directorio y cuota del plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Directorio retorna personal y maxActiveAccounts', () => {",
              "  pm.response.to.have.status(200);",
              "  const dir = pm.response.json();",
              "  pm.expect(dir.tenantSlug).to.eql('clinica-norte');",
              "  pm.expect(dir.maxActiveAccounts).to.eql(8);",
              "  const aux = dir.accounts.find(a => a.email === 'aux.ramirez@norte.vital.demo');",
              "  const mendoza = dir.accounts.find(a => a.email === 'dra.mendoza@norte.vital.demo');",
              "  const vega = dir.accounts.find(a => a.email === 'dr.vega@norte.vital.demo');",
              "  pm.expect(aux).to.not.be.undefined;",
              "  pm.expect(mendoza).to.not.be.undefined;",
              "  pm.expect(vega).to.not.be.undefined;",
              "  pm.collectionVariables.set('auxAccountId', aux.id);",
              "  pm.collectionVariables.set('activeSpecId', mendoza.id);",
              "  pm.collectionVariables.set('inactiveSpecId', vega.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
