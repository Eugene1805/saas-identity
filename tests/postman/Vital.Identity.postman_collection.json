      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken1}}\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/refresh"
      }
    },
